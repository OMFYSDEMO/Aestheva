{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aestheva",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Create with `npx wrangler d1 create aestheva`, then paste the id here and under env.production.
  "d1_databases": [
    { "binding": "DB", "database_name": "aestheva", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Every 5 minutes: release unpaid slot holds.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },

  // Local development. Without Razorpay keys the booking page offers a simulated payment.
  // To test real Razorpay test-mode checkout locally, put RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET in .dev.vars.
  "vars": {
    "APP_ENV": "development",
    "SITE_URL": "",
    "RAZORPAY_KEY_ID": ""
  },

  "env": {
    "production": {
      "name": "aestheva",
      "d1_databases": [
        { "binding": "DB", "database_name": "aestheva", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "observability": { "enabled": true },
      "vars": {
        "APP_ENV": "production",
        "SITE_URL": "",
        // Public key id (rzp_live_...). The secrets are set with:
        //   npx wrangler secret put RAZORPAY_KEY_SECRET --env production
        //   npx wrangler secret put RAZORPAY_WEBHOOK_SECRET --env production
        "RAZORPAY_KEY_ID": ""
      }
    }
  }
}
