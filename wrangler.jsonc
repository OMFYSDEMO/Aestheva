{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is PRODUCTION, so Cloudflare's Git deploy (default command `npx wrangler deploy`) needs no settings.
  // Local development uses `--env dev` (see package.json), which overrides the variables below.
  "name": "aestheva",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Production database (APAC), created October 2026.
  "d1_databases": [
    { "binding": "DB", "database_name": "aestheva", "database_id": "d4250b41-2f5b-4dbc-9e58-dc7f1acb4fe8", "migrations_dir": "migrations" }
  ],
  // Every 5 minutes: release unpaid slot holds.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  // bookaestheva.com is registered through Cloudflare in this account; deploy attaches both hostnames and certificates.
  // www redirects to the bare domain in the Worker.
  "routes": [
    { "pattern": "bookaestheva.com", "custom_domain": true },
    { "pattern": "www.bookaestheva.com", "custom_domain": true }
  ],
  "workers_dev": false,
  // Keep values added in the dashboard when Git pushes redeploy. Secrets always survive; this also protects any
  // value accidentally saved as type Text instead of Secret.
  "keep_vars": true,
  // Team emails (new applications). Delivers to addresses verified in Cloudflare Email Routing; see README.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "APP_ENV": "production",
    "SITE_URL": "https://bookaestheva.com"
    // Set as Secrets in the dashboard (Worker > Settings > Variables and Secrets), never here:
    // RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, PREVIEW_KEY, OPS_KEY, NOTIFY_EMAIL.
  },

  "env": {
    // Local development: `npm run dev`. Uses a local copy of the database, never production.
    // Without Razorpay keys the booking page offers a simulated payment.
    "dev": {
      "d1_databases": [
        { "binding": "DB", "database_name": "aestheva", "database_id": "d4250b41-2f5b-4dbc-9e58-dc7f1acb4fe8", "migrations_dir": "migrations" }
      ],
      "workers_dev": true,
      "routes": [],
      "vars": { "APP_ENV": "development", "SITE_URL": "", "RAZORPAY_KEY_ID": "" }
    }
  }
}
